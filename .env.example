# Copy this file to `.env` and fill in the values. Never commit `.env` (it is git-ignored).
# Full step-by-step setup: docs/SETUP.md

# --- Blockscout (explorer data + fallback RPC). Free key: https://dev.blockscout.com
# Used by the scanner (CLI + ingest job). Without it, explorer-based checks show "unknown".
BLOCKSCOUT_API_KEY=

# --- Cloudflare D1 database "kestrion" (used by the ingest job through the REST API). Not secret.
CLOUDFLARE_ACCOUNT_ID=623693bd9e26d8a4f91459bd23b37b8a
D1_DATABASE_ID=ea6b1b65-5ff7-4a2c-91a0-5547fbc4801e
# API token with "D1: Edit" permission (secret). Locally the CLOUDFLARE_API_TOKEN user env var is used if this is empty.
CLOUDFLARE_D1_TOKEN=

# --- Optional RPC overrides.
# Primary RPC. Default: https://rpc.mainnet.chain.robinhood.com (some internet providers block it).
RPC_URL=
# Fallback RPC. Default: Blockscout JSON-RPC built from BLOCKSCOUT_API_KEY.
FALLBACK_RPC_URL=

# --- Ingest job tuning (optional).
# INGEST_TIME_BUDGET_MS=480000
# INGEST_INITIAL_LOOKBACK_BLOCKS=3000
# INGEST_CONCURRENCY=3

# --- Optional: AI summaries (Phase 6) -------------------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey. Empty = no AI summaries (everything else works).
# On GitHub: repository secret GEMINI_API_KEY. The score never depends on it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Website admin (Phase 6) -----------------------------------------------------------------------------------
# Wallets allowed on /admin are set in apps/web/wrangler.jsonc ("vars" → ADMIN_WALLETS), comma-separated.
